# Docker compose / 로컬용 (필요할 때만)
# POSTGRES_USER=autocoin
# POSTGRES_PASSWORD=
# POSTGRES_DB=autocoin
# DATABASE_URL=postgresql+asyncpg://...
# API_HOST=0.0.0.0
# API_PORT=8000
#
# 잡 poller (job_runner/poller.py — utils.config.Settings)
# AUTOCOIN_JOB_POLL_INTERVAL_SEC=1.0
# AUTOCOIN_JOB_CLAIM_LIMIT=200
# AUTOCOIN_JOB_WORKER_COUNT=4
# AUTOCOIN_JOB_RETRY_MAX=3
#
# 로깅 (utils.logging_setup / utils.config.Settings)
# LOG_LEVEL=INFO
# LOG_JSON_CONSOLE=false
# LOG_DIR=./log
# LOG_FILE=autocoin.log
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5
# (LOG_FILE 비우면 파일 로그 끔. uvicorn이 먼저 콘솔 핸들러를 붙여도 파일 핸들러는 보강됨)
#
# Docker: compose에 ./log:/app/log 마운트 시 호스트 ./log/autocoin.log 와 동기화
#
# 리스크 관리 — DB에서 관리 (텔레그램 /risk 명령으로 변경)
# 기본값: max_per_trade=5%, daily=10회, reserve=100,000원
#
# 텔레그램 봇 (telegram.bot)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
#
# Ollama 로컬 LLM (ai_engine.local_llm)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_NUM_GPU=0
# OLLAMA_TIMEOUT=60.0
#
# 캔들 수집 스케줄러 (collector.scheduler)
# AUTOCOIN_CANDLE_INTERVAL_SEC=60.0
# AUTOCOIN_CANDLE_UNIT=1
# AUTOCOIN_CANDLE_COUNT=1
#
# 빗썸 클라이언트 (bithumb.*)
# BITHUMB_API_KEY=
# BITHUMB_SECRET_KEY=
# BITHUMB_BASE_URL=https://api.bithumb.com
# BITHUMB_MAX_REQUESTS_PER_SEC=15
