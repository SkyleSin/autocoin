# =============================================================================
# Coin Trader — 환경 변수 (.env 로 복사 후 값 채우기, 커밋 금지)
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL (Docker ct-db + 로컬에서 DB 붙을 때) ---
POSTGRES_USER=autocoin
POSTGRES_PASSWORD=
POSTGRES_DB=autocoin

# 호스트에 노출할 포트 (루트 compose의 ct-db)
POSTGRES_PUBLISH_PORT=5432

# Dev Container 전용 Postgres 노출 포트 (루트 compose 5432와 겹치지 않게, 기본 5433)
DEVCONTAINER_POSTGRES_PORT=5433

# --- DB 연결 URL ---
# 로컬 venv / IDE에서 앱·Alembic 실행 시 (호스트가 127.0.0.1)
DATABASE_URL=postgresql+asyncpg://autocoin:***REMOVED***@127.0.0.1:5432/autocoin

# Docker Compose의 ct-api 전용 (호스트명은 반드시 ct-db)
DATABASE_URL_DOCKER=postgresql+asyncpg://autocoin:***REMOVED***@ct-db:5432/autocoin

# --- 빗썸 Open API ---
BITHUMB_API_KEY=
BITHUMB_SECRET_KEY=
# BITHUMB_BASE_URL=https://api.bithumb.com

# --- HTTP API (FastAPI) ---
API_AUTH_TOKEN=

API_HOST=0.0.0.0
API_PORT=8000
API_PUBLISH_PORT=8000

# SQL 로그 (디버그)
# DB_ECHO_SQL=true
