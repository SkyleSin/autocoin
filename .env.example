# Docker compose / 로컬용 (필요할 때만)
# POSTGRES_USER=autocoin
# POSTGRES_PASSWORD=
# POSTGRES_DB=autocoin
# DATABASE_URL=postgresql+asyncpg://...
# API_HOST=0.0.0.0
# API_PORT=8000
#
# 로깅 (utils.logging_setup / utils.config.Settings)
# LOG_LEVEL=INFO
# LOG_JSON_CONSOLE=false
# LOG_DIR=./log
# LOG_FILE=
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5
#
# 빗썸 클라이언트 (bithumb.*)
# BITHUMB_API_KEY=
# BITHUMB_SECRET_KEY=
# BITHUMB_BASE_URL=https://api.bithumb.com
#
# 잡 워커 — FastAPI 앱 기동 시 같이 뜸 (AUTOCOIN_WORKER_ 접두사)
# AUTOCOIN_WORKER_COUNT=15
# AUTOCOIN_WORKER_POLL_INTERVAL_SEC=1.0
# AUTOCOIN_WORKER_CLAIM_LIMIT=200
