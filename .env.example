# ============================================================
# autocoin v2 — 환경 변수 설정
# .env로 복사 후 값을 채워 사용
# ============================================================

# ── PostgreSQL ──
POSTGRES_USER=autocoin
POSTGRES_PASSWORD=
POSTGRES_DB=autocoin

# ── 암호화 (Fernet AES-128) ──
# 생성: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPT_KEY=

# ── 텔레그램: 유저 봇 (시그널 알림, 매매 버튼) ──
TELEGRAM_BOT_TOKEN=

# ── 텔레그램: master 봇 (시스템 상태, 에러, safety/shock 알림) ──
MASTER_BOT_TOKEN=
MASTER_TELEGRAM_ID=

# ── 빗썸 API ──
BITHUMB_API_KEY=
BITHUMB_SECRET_KEY=
BITHUMB_BASE_URL=https://api.bithumb.com
BITHUMB_MAX_REQUESTS_PER_SEC=15

# ── LLM: DeepSeek R1 (우선) ──
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-reasoner
DEEPSEEK_TIMEOUT=120.0

# ── LLM: Ollama (폴백) ──
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_NUM_GPU=0
OLLAMA_TIMEOUT=60.0

# ── 로깅 ──
LOG_LEVEL=INFO
LOG_DIR=./log
LOG_FILE=autocoin.log
